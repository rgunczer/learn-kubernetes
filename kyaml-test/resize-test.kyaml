---
{
  apiVersion: "v1",
  kind: "Pod",
  metadata: {
    name: "resize-test-kyaml",
  },
  spec: {
    containers: [{
      name: "nginx",
      image: "nginx:stable",
      resources: {
        requests: {
          cpu: "100m",
          memory: "32Mi",
        },
        limits: {
          cpu: "300m",
          memory: "128Mi",
        },
      },
    }],
  },
}
